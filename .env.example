# Copy this file to .env and fill in your values.

# ── Routing backend (priority: OSRM > Google Maps > haversine) ────────────────
OSRM_URL=http://localhost:5000          # self-hosted OSRM (free, recommended)
GOOGLE_MAPS_API_KEY=                    # fallback if OSRM is unavailable

# ── SMS alerts (optional) ─────────────────────────────────────────────────────
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM_NUMBER=

# ── Storage ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./route_intelligence.db
MODEL_DIR=./saved_models

# ── Operational thresholds ────────────────────────────────────────────────────
SHIFT_DURATION_MINS=480
MAX_VEHICLE_CAPACITY_KG=500
HIGH_RISK_THRESHOLD=0.70
MEDIUM_RISK_THRESHOLD=0.40

# ── Solver ────────────────────────────────────────────────────────────────────
VRP_TIME_LIMIT_SECONDS=30

# ── Dashboard ─────────────────────────────────────────────────────────────────
ROUTE_INTEL_API_URL=http://localhost:8000
